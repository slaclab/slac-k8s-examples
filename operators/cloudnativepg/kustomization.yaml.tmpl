# Template that `make resource` copies to kustomization.yaml before it adds one line per object
# of the downloaded release under resources/. Edit this file, not kustomization.yaml.
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
namespace: cnpg-system
resources:
- ns.yaml

patches:
- path: deployment-cnpg-manager-patch.yaml
